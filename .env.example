# Copy to `.env.local` for Next.js / local tooling (never commit real secrets).

# Postgres connection string for Drizzle (`db/index.ts` → `getDb()`).
# Can point at the same Postgres instance Supabase uses, or a separate DB — v1 default is Postgres (MASTER).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fabrika3

# Supabase project (Auth + API). From Dashboard → Settings → API (legacy anon key still supported).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
